# The facts the engine needs before any model code runs (CONTRACT.md, Manifest).
# The runtime's `open` reports the same values in its Facts; a disagreement is a
# hard error, never a fixup. Replace every value with your model's.

name = "my-model"                 # package identity; keys reused cache state
backends = ["example"]            # hardware folders present; must match the disk
max_batch = 1                     # items one step may carry; raise it once batched rows are exact
max_context = 4096                # most tokens one request may carry
cache_bytes_per_token = 0         # the cache's growing cost per token (e.g. KV bytes, all layers)
capabilities = []                 # "speculative", "label_logprobs", "tool_calls", "logprobs"
# thinking_levels = ["high", "low"]   # only if the chat template offers named levels

# Optional: the package's own settings, read by its runtime after load. The
# engine only checks that it is a table.
# [runtime]
# kv_cache = "fp16"
